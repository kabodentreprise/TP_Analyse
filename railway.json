{
  "build": {
    "builder": "nixpacks",
    "buildCommand": "pip install -r backend/api_gateway/requirements.txt"
  },
  "start": "cd backend/api_gateway && uvicorn main:app --host 0.0.0.0 --port $PORT",
  "enviroments": {
    "DATABASE_URL": "${DATABASE_URL}",
    "SECRET_KEY": "${SECRET_KEY}",
    "ALGORITHM": "HS256",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "30"
  }
}
